# IDE / editor
.idea/
.vscode/
*.iml
*.swp
*.swo

# Claude Code local state
.claude/
# Local-only project instructions (the canonical copy lives in
# docs/internal/CLAUDE.md; a root copy makes Claude Code auto-load it without
# putting AI-session notes on the public repo landing page).
/CLAUDE.md

# OS
.DS_Store
Thumbs.db
desktop.ini

# Java / Gradle (backend)
Manhaji/backend/build/
Manhaji/backend/.gradle/
Manhaji/backend/out/
Manhaji/backend/.idea/
Manhaji/backend/*.log
Manhaji/backend/HELP.md

# Runtime-generated artifacts — TTS MP3 cache, voice recordings, etc.
# FileStorageService writes these into ./uploads/* relative to the boot
# CWD (which is backend/ during `./gradlew bootRun`). They're per-laptop
# state, not source.
Manhaji/backend/uploads/

# Flutter / Dart (manhaji_app)
Manhaji/manhaji_app/.dart_tool/
Manhaji/manhaji_app/.flutter-plugins
Manhaji/manhaji_app/.flutter-plugins-dependencies
Manhaji/manhaji_app/.packages
Manhaji/manhaji_app/build/
Manhaji/manhaji_app/.metadata
# pubspec.lock IS tracked for applications (reproducible builds) — only
# untrack for libraries. Flutter convention: applications commit it.

# Android / iOS build artifacts
Manhaji/manhaji_app/android/.gradle/
Manhaji/manhaji_app/android/local.properties
Manhaji/manhaji_app/android/key.properties
Manhaji/manhaji_app/android/**/build/
Manhaji/manhaji_app/ios/Pods/
Manhaji/manhaji_app/ios/.symlinks/
Manhaji/manhaji_app/ios/Flutter/Flutter.framework
Manhaji/manhaji_app/ios/Flutter/Generated.xcconfig
Manhaji/manhaji_app/ios/Flutter/flutter_export_environment.sh

# Generated mocks (regenerable)
Manhaji/manhaji_app/test/**/*.mocks.dart

# PDF extractor tool — Python virtualenv / cache
tools/pdf_extractor/.venv/
tools/pdf_extractor/__pycache__/
tools/pdf_extractor/*.pyc

# Curriculum extractor — extraction output (ephemeral; final artifacts go
# to Manhaji/backend/src/main/resources/{curriculum,static/assets/...})
tools/curriculum_extractor/.venv/
tools/curriculum_extractor/__pycache__/
tools/curriculum_extractor/*.pyc
tools/curriculum_extractor/_out/

# Curriculum backfill scripts — Python cache
Manhaji/scripts/**/__pycache__/
Manhaji/scripts/**/*.pyc

# Secrets / credentials (never commit)
*.env
*.env.local
.env
.env.*
!.env.example
secrets.properties
google-services.json

# Logs
*.log
logs/

# Temp / scratch
*.tmp
*.bak
*.backup
*~

# Build outputs
*.class
*.jar
*.war
*.ear
target/
node_modules/

# Exception: the Gradle wrapper jar MUST be tracked so a fresh clone can run
# `./gradlew` without having Gradle pre-installed. (Flutter android/'s own
# .gitignore intentionally still excludes its wrapper — Android Studio
# regenerates it — so this exception only re-enables the Spring Boot one.)
!**/gradle/wrapper/gradle-wrapper.jar

# Python
*.pyc
__pycache__/
.pytest_cache/

# Test / debug artifacts (Android dumps, screenshots)
screen*.png
screen_p2_*.png
dump_*.xml
window_dump*.xml
ui.xml
toc_extract.txt

# macOS finder + Linux thumbnails
.DS_Store
Thumbs.db

# Partner reference repo (analysis-only, never publish)
OtherCode/
