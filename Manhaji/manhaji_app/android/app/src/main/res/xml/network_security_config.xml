<?xml version="1.0" encoding="utf-8"?>
<!--
    Network security policy for the Manhaji Android app.

    Production traffic uses HTTPS only — the default-config block below
    forbids cleartext globally so a misconfigured production endpoint
    can never silently fall back to http://.

    Cleartext is permitted ONLY for the local development addresses used
    to reach the Spring Boot backend while testing:
      - 10.0.2.2        : the Android emulator's magic alias for the
                          host machine's loopback. This is what
                          api_config.dart points at (kIsWeb ? '/api' :
                          'http://10.0.2.2:8080/api').
      - 127.0.0.1       : the address Android's cleartext filter actually
                          sees after resolving 10.0.2.2. Without this
                          entry just_audio + ExoPlayer playback of
                          /uploads/audio/* fails with
                          CleartextNotPermittedException even though
                          regular Dio calls succeed (Dio's HttpClient and
                          ExoPlayer's OkHttp evaluate the policy at
                          slightly different layers).
      - localhost       : convenience for physical-device + adb-reverse
                          testing.

    For a real deployment (Phase 1+), point api_config.dart at an HTTPS
    URL and delete the entire <domain-config> block below — the
    default-config will then enforce HTTPS for every request.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false"/>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
